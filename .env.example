# 阿里云百炼 DashScope API 配置
# 复制本文件为 .env 并填入你的 API Key（阿里云百炼控制台创建：https://bailian.console.aliyun.com/）

# 必填：你的阿里云百炼 API Key（sk- 开头）
DASHSCOPE_API_KEY=sk-请替换为你的APIKey

# 可选：默认模型
DEFAULT_CHAT_MODEL=qwen-plus
DEFAULT_IMAGE_MODEL=wanx2.1-t2i-turbo
DEFAULT_VISION_MODEL=qwen-vl-max

# 可选：服务端口
PORT=3000

# 可选：是否打印详细日志
VERBOSE=false
