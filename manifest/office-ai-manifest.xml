<?xml version="1.0" encoding="UTF-8"?>
<!--
  Office AI 助手 —— Office.js 加载项清单
  支持 Word / Excel / PowerPoint（桌面 + 网页端）。
  注意：
  - ID 唯一；Sources 指向本地后端服务（http://localhost:3000）。
  - 本地联调时用下面的 office-ai-manifest.xml 通过 "旁加载" 导入。
  - 生产环境请把 URL 替换为你的 https 域名，并按 Microsoft 要求
    （Office 外接程序清单 1.1 schema）校验后提交商店。
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">

  <Id>a1b2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Office AI Assistant</ProviderName>
  <DefaultLocale>zh-CN</DefaultLocale>

  <DisplayName DefaultValue="Office AI 助手"/>
  <Description DefaultValue="基于阿里云百炼 DashScope 官方接口的 Office 智能助手，支持文本写作、图片生成、文档理解。"/>

  <IconUrl DefaultValue="https://localhost:3000/manifest/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/manifest/icon-64.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/manifest/support.html"/>

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
    <AppDomain>http://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
    <Host Name="Workbook"/>
    <Host Name="Presentation"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="http://localhost:3000/taskpane/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="OfficeAIGroup">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="OpenTaskpaneButton">
                  <Label resid="Taskpane.Button.Label"/>
                  <Supertip>
                    <Title resid="Taskpane.Button.Label"/>
                    <Description resid="Taskpane.Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>

      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="OfficeAIGroupXL">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="OpenTaskpaneButtonXL">
                  <Label resid="Taskpane.Button.Label"/>
                  <Supertip>
                    <Title resid="Taskpane.Button.Label"/>
                    <Description resid="Taskpane.Button.Tooltip"/>
                  </Supertip>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1XL</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>

      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="OfficeAIGroupPPT">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="OpenTaskpaneButtonPPT">
                  <Label resid="Taskpane.Button.Label"/>
                  <Supertip>
                    <Title resid="Taskpane.Button.Label"/>
                    <Description resid="Taskpane.Button.Tooltip"/>
                  </Supertip>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1PPT</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="http://localhost:3000/manifest/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="http://localhost:3000/manifest/icon-32.png"/>
        <bt:Image id="Icon.64" DefaultValue="http://localhost:3000/manifest/icon-64.png"/>
        <bt:Image id="Icon.80" DefaultValue="http://localhost:3000/manifest/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="http://localhost:3000/taskpane/taskpane.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="http://localhost:3000/manifest/support.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Office AI 助手已就绪"/>
        <bt:String id="Group.Label" DefaultValue="Office AI"/>
        <bt:String id="Taskpane.Button.Label" DefaultValue="打开 AI 助手"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="使用阿里云百炼大模型完成写作、润色、翻译、图片生成与文档理解。"/>
        <bt:String id="Taskpane.Button.Tooltip" DefaultValue="点击打开 Office AI 助手任务窗格"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
